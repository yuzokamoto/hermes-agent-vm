# Copy to .env, review the values, then run: make bootstrap
# Never commit .env. Provider credentials and OAuth sessions stay in their own CLIs.

# Required workstation identity
WORKSTATION_USER=
GIT_USER_NAME=
GIT_USER_EMAIL=

# Host preferences
TIMEZONE=America/Sao_Paulo
LOCALE=en_US.UTF-8
WORKSPACE_ROOT=$HOME/workspaces
KNOWLEDGE_ROOT=$HOME/knowledge
HERMES_HOME=$HOME/.hermes

# Optional components
INSTALL_DOCKER=true

# Supply-chain policy: do not install ecosystem releases newer than this age.
PACKAGE_MINIMUM_RELEASE_AGE=3d

# Backups
BACKUP_ENABLED=true
RESTIC_REPOSITORY=$HOME/backups/hermes-restic
RESTIC_PASSWORD=
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
