# Copy to .env, review every value, then run: make bootstrap
# Never commit .env. OAuth logins for Codex, Claude and WhatsApp remain interactive.

# Workstation identity
WORKSTATION_NAME=hermes-local
WORKSTATION_USER=
TIMEZONE=America/Sao_Paulo
LOCALE=en_US.UTF-8
GIT_USER_NAME=
GIT_USER_EMAIL=
GITHUB_USERNAME=

# Installation profile
INSTALL_GUI=true
INSTALL_DOCKER=true
INSTALL_TAILSCALE=false
INSTALL_OBSIDIAN=false
DESKTOP_ENVIRONMENT=xfce
HERMES_HOME=$HOME/.hermes
HERMES_INSTALL_URL=https://hermes-agent.nousresearch.com/install.sh
HERMES_RELEASE_CHANNEL=stable
WORKSPACE_ROOT=$HOME/workspaces
KNOWLEDGE_ROOT=$HOME/knowledge

# Provider routing. Subscription-backed CLIs are authenticated interactively.
PRIMARY_CODING_PROVIDER=codex
SECONDARY_CODING_PROVIDER=claude
FALLBACK_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_MONTHLY_BUDGET_USD=20

# WhatsApp. Use a dedicated account when possible.
WHATSAPP_ENABLED=false
WHATSAPP_TRANSPORT=baileys
WHATSAPP_ALLOWED_NUMBER=
WHATSAPP_NOTIFY_ON=task_completed,task_blocked,task_failed,approval_required,backup_failed

# Safety policy
ALLOW_PRODUCTION_ACCESS=false
REQUIRE_APPROVAL_FOR_DESTRUCTIVE_ACTIONS=true
REQUIRE_APPROVAL_FOR_EXTERNAL_MESSAGES=true
REQUIRE_APPROVAL_FOR_PURCHASES=true

# Backup. RESTIC_REPOSITORY may be local initially or an S3-compatible target later.
BACKUP_ENABLED=true
RESTIC_REPOSITORY=$HOME/backups/hermes-restic
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6

# Observability and evaluations
ENABLE_HERMES_DASHBOARD=true
DASHBOARD_BIND=127.0.0.1
ENABLE_PROMPT_EVALS=true
EVAL_MAX_COST_USD=5

# Optional integrations. Prefer OAuth or scoped tokens created for this VM.
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
